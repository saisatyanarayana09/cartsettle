# PythonAnywhere / Django deployment settings
DJANGO_ENV=production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com

# Neon: copy the pooled PostgreSQL connection string from the Neon console.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require

# Vercel frontend origin. Multiple origins may be comma-separated.
FRONTEND_URL=https://your-project.vercel.app
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional email delivery
EMAIL_HOST_USER=your-smtp-user@example.com
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=your-smtp-user@example.com

# PayPal Sandbox Credentials
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret

# Multi-Provider AI Resilient Failover (3-Key Failover Pool)
# Tier 1: Primary Google Gemini Key
GEMINI_API_KEY=your_gemini_api_key_primary
# Tier 2: Secondary / Backup Google Gemini Key (separate Google account / quota)
GEMINI_API_KEY_2=your_gemini_api_key_backup
# Tier 3: Groq Cloud LPU Key (Ultra-fast cross-provider failover, free at console.groq.com)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b,llama-3.3-70b-versatile
# Tier 4: CartSettle Local Deterministic Engine (Zero-API 100% offline baseline)

